# ---- build-time (compiled into the browser bundle) ----
NEXT_PUBLIC_FAIRDROP_LIVE=1                      # 1 = customer + admin talk to the real backend; unset/0 = self-contained in-browser simulation
NEXT_PUBLIC_ML_API_URL=http://127.0.0.1:8001     # Person 2 ML service (read by the admin Intelligence/Campaigns/Attacks panels)
# ---- server-side only (Next.js server; never sent to browsers) ----
FAIRDROP_API_URL=http://127.0.0.1:8000           # Person 1 backend
FAIRDROP_ADMIN_KEY=                              # must equal backend ADMIN_API_KEY
FAIRDROP_INTEGRATION_KEY=                        # must equal backend INTEGRATION_API_KEY
FAIRDROP_COOKIE_SECRET=                          # signs the organizer cookie (defaults to FAIRDROP_ADMIN_KEY)
FAIRDROP_ADMIN_EMAIL=admin@fairdrop.demo         # demo organizer credentials (same defaults as the original admin login)
FAIRDROP_ADMIN_PASSWORD=FairDrop@2026
LIVE_PREQUEUE_SECONDS=45                         # pre-queue window used when a catalogue event is first provisioned (demo-compressed)
LIVE_ADMISSION_LIMIT=25                          # max concurrently admitted sessions
LIVE_AUTO_OPEN=1                                 # open the pre-queue on first join of a LIVE catalogue drop (0 = organizer opens it)
LIVE_AUTOPILOT=1                                 # backend auto-advances phases on timers (0 = organizer drives every phase)
# NEXT_DIST_DIR=.next                            # build output dir (lets a simulation build and a live build coexist)
