ENVIRONMENT=development
DATABASE_URL=sqlite:///./fair_drop.db
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
HOLD_SECONDS=120
SESSION_TTL_SECONDS=1800
QUEUE_TOKEN_TTL_SECONDS=300
ADMISSION_TTL_SECONDS=900
ADMISSION_WINDOW=100
ALLOCATION_RETRY_ATTEMPTS=8
RATE_LIMIT_WINDOW_SECONDS=10
RATE_LIMIT_REQUESTS=100
MUTATION_RATE_LIMIT_REQUESTS=30
MUTATION_RATE_LIMIT_WINDOW_SECONDS=10
QUEUE_POLL_RATE_LIMIT=30
QUEUE_POLL_WINDOW_SECONDS=10
HMAC_SECRET=replace-with-a-long-random-secret
ALLOW_DIRECT_ALLOCATION=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RESILIENCE_QUEUE_DEPTH_THRESHOLD=5000
RESILIENCE_RATE_THRESHOLD=1000
RESILIENCE_ERROR_ELEVATED=0.05
RESILIENCE_ERROR_DEGRADED=0.10
RESILIENCE_ERROR_PROTECTIVE=0.25
ENABLE_EXPIRY_WORKER=true
EXPIRY_WORKER_INTERVAL_SECONDS=5
LOG_LEVEL=INFO

# Deterministic policy (all thresholds are explicit and versioned)
POLICY_VERSION=policy-v1
POLICY_CHALLENGE_RISK=0.50
POLICY_THROTTLE_RISK=0.75
POLICY_QUARANTINE_RISK=0.90
POLICY_REJECT_RISK=0.99
POLICY_ANOMALY_CHALLENGE=0.80
POLICY_COORDINATION_THRESHOLD=0.90
POLICY_COORDINATION_REPEAT_COUNT=2
POLICY_CAMPAIGN_MIN_SESSIONS=5
POLICY_HARD_EVIDENCE=replayed_admission_token,forged_admission_token,credential_stuffing,known_bad_actor
POLICY_TTL_CHALLENGE_SECONDS=900
POLICY_TTL_THROTTLE_SECONDS=900
POLICY_TTL_QUARANTINE_SECONDS=3600
POLICY_TTL_REJECT_SECONDS=86400
POLICY_THROTTLE_ADMIT_INTERVAL_SECONDS=20
POLICY_CHALLENGE_DIFFICULTY_BITS=16
# Optional Person 2 ML service for pull-sync (empty = ML not configured; backend runs without it)
ML_API_URL=
ML_API_TIMEOUT_SECONDS=2.0
# >0 (and ML_API_URL set) = background pull of P2 RiskEvents into the policy engine every N seconds; 0 = only the admin 'Sync' button / POST /integration/ml/sync
ML_SYNC_INTERVAL_SECONDS=0
# Shared secret Person 2 / ops must send as X-Integration-Key (REQUIRED in production)
INTEGRATION_API_KEY=
REDIS_RECONNECT_INTERVAL_SECONDS=5
# Operator key for /admin/*, POST /events and POST /inventory/seed (REQUIRED in production; the Next.js server proxy injects it, browsers never see it)
ADMIN_API_KEY=
